# DeepSeek (OpenAI-compatible). Required.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional existing .env file; exported variables/project .env take precedence.
# MOMENTUM_ENV_FILE=/absolute/path/to/shared/.env
# Legacy DeepSeekAPI is also accepted when DEEPSEEK_API_KEY is empty/unset.

# Optional overrides.
# Official API ID for DeepSeek V4.1 Flash (September 10, 2026 release).
SUB_AGENT_MODEL=deepseek-flash
COORDINATOR_MODEL=deepseek-flash

# Optional. Directory of momentum-tail-risk-monitor (or a copy of its outputs/).
# If unset, engine_query looks for ../momentum-tail-risk-monitor next to this repo.
# MOMENTUM_ENGINE_DIR=/Users/you/Desktop/momentum-tail-risk-monitor
# Pin a specific snapshot instead of latest_assessment.json:
# MOMENTUM_ENGINE_SNAPSHOT=/Users/you/Desktop/momentum-tail-risk-monitor/outputs/latest_assessment.json

# Native search uses the same DeepSeek key. No Tavily/Serper key required.
# auto = native when DeepSeek configured, otherwise legacy Serper/Tavily.
# deepseek = native only; legacy = explicitly retain Serper/Tavily.
WEB_SEARCH_PROVIDER=auto
SERPER_API_KEY=
TAVILY_API_KEY=
